<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  @media (max-width: 600px) {
    .container { width: 100% !important; border-radius: 0 !important; }
    .pad { padding-left: 20px !important; padding-right: 20px !important; }
    .code { font-size: 32px !important; letter-spacing: 6px !important; padding: 14px 18px !important; }
  }
  @media (prefers-color-scheme: dark) {
    .bg { background-color: #0b0f19 !important; }
    .card { background-color: #111827 !important; }
    .title, .strong { color: #f9fafb !important; }
    .text { color: #d1d5db !important; }
    .muted { color: #9ca3af !important; }
    .codebox { background-color: #1e1b4b !important; border-color: #818cf8 !important; }
    .code { color: #c7d2fe !important; }
    .panel { background-color: #1f2937 !important; border-color: #374151 !important; }
    .warn { background-color: #3b2a0a !important; border-color: #f59e0b !important; }
    .warn-text { color: #fcd34d !important; }
    .divider { border-color: #374151 !important; }
  }
</style>
</head>
<body class="bg" style="margin:0;padding:0;background-color:#f3f4f6;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f3f4f6;">{{.Preheader}} &#8199;&#847; &#8199;&#847; &#8199;&#847;</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg" style="background-color:#f3f4f6;padding:32px 12px;">
<tr><td align="center">

<table role="presentation" width="600" cellpadding="0" cellspacing="0" class="container card" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:14px;overflow:hidden;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">

  <!-- Шапка -->
  <tr><td class="pad" style="background-color:#312e81;padding:28px 36px;">
    <span style="font-size:24px;font-weight:700;color:#ffffff;letter-spacing:0.3px;">{{.AppName}}</span>
    <span style="display:block;margin-top:4px;font-size:13px;color:#c7d2fe;">Совместная работа над кодом</span>
  </td></tr>

  <!-- Заголовок -->
  <tr><td class="pad" style="padding:36px 36px 8px 36px;">
    <div style="font-size:36px;line-height:1;margin-bottom:12px;">{{.Emoji}}</div>
    <h1 class="title" style="margin:0 0 14px 0;font-size:26px;line-height:1.3;color:#111827;">{{.Heading}}</h1>
    <p class="text" style="margin:0;font-size:16px;line-height:1.65;color:#374151;">{{.Intro}}</p>
  </td></tr>

  <!-- Код -->
  <tr><td class="pad" align="center" style="padding:28px 36px 8px 36px;">
    <p class="muted" style="margin:0 0 10px 0;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#6b7280;">Ваш одноразовый код</p>
    <div class="codebox" style="display:inline-block;background-color:#eef2ff;border:2px dashed #6366f1;border-radius:14px;padding:18px 36px;">
      <span class="code" style="font-family:'SFMono-Regular',Consolas,'Courier New',monospace;font-size:42px;font-weight:700;letter-spacing:12px;color:#312e81;">{{.Code}}</span>
    </div>
    <p class="muted" style="margin:14px 0 0 0;font-size:14px;color:#6b7280;">Код действует <strong class="strong" style="color:#111827;">{{.TTL}}</strong> и подходит только для одного использования.</p>
  </td></tr>

  <!-- Детали запроса -->
  <tr><td class="pad" style="padding:28px 36px 8px 36px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="panel" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;">
      <tr><td style="padding:16px 20px 6px 20px;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#6b7280;" class="muted">Детали запроса</td></tr>
      <tr><td style="padding:0 20px 16px 20px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;">
          <tr>
            <td class="muted" style="padding:6px 0;color:#6b7280;width:42%;">Действие</td>
            <td class="strong" style="padding:6px 0;color:#111827;font-weight:600;">{{.Purpose}}</td>
          </tr>
          <tr>
            <td class="muted" style="padding:6px 0;color:#6b7280;">Запрошен</td>
            <td class="strong" style="padding:6px 0;color:#111827;font-weight:600;">{{.RequestedAt}}</td>
          </tr>
          <tr>
            <td class="muted" style="padding:6px 0;color:#6b7280;">Действителен до</td>
            <td class="strong" style="padding:6px 0;color:#111827;font-weight:600;">{{.ExpiresAt}}</td>
          </tr>
        </table>
      </td></tr>
    </table>
  </td></tr>

  <!-- Что делать дальше -->
  <tr><td class="pad" style="padding:24px 36px 8px 36px;">
    <h2 class="title" style="margin:0 0 12px 0;font-size:18px;color:#111827;">Что делать дальше</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    {{range $i, $s := .Steps}}
      <tr>
        <td valign="top" width="36" style="padding:6px 0;">
          <div style="width:26px;height:26px;line-height:26px;border-radius:13px;background-color:#6366f1;color:#ffffff;font-size:13px;font-weight:700;text-align:center;">{{inc $i}}</div>
        </td>
        <td class="text" valign="top" style="padding:6px 0 6px 0;font-size:15px;line-height:1.55;color:#374151;">{{$s}}</td>
      </tr>
    {{end}}
    </table>
  </td></tr>

  <!-- Безопасность -->
  <tr><td class="pad" style="padding:24px 36px 8px 36px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="warn" style="background-color:#fffbeb;border-left:4px solid #f59e0b;border-radius:6px;">
      <tr><td class="warn-text" style="padding:16px 20px;font-size:14px;line-height:1.65;color:#92400e;">
        <strong style="display:block;margin-bottom:6px;font-size:15px;">Правила безопасности</strong>
        &bull; Никому не сообщайте этот код, даже если вас просят об этом от имени {{.AppName}}.<br>
        &bull; Сотрудники {{.AppName}} никогда не спрашивают коды подтверждения.<br>
        &bull; Не пересылайте это письмо и не публикуйте скриншоты с кодом.
      </td></tr>
    </table>
  </td></tr>

  <!-- Не вы? -->
  <tr><td class="pad" style="padding:20px 36px 8px 36px;">
    <h2 class="title" style="margin:0 0 8px 0;font-size:16px;color:#111827;">Не вы запрашивали код?</h2>
    <p class="text" style="margin:0;font-size:14px;line-height:1.65;color:#4b5563;">{{.Ignore}}</p>
  </td></tr>

  <!-- Подвал -->
  <tr><td class="pad" style="padding:28px 36px 32px 36px;">
    <hr class="divider" style="border:none;border-top:1px solid #e5e7eb;margin:0 0 16px 0;">
    <p class="muted" style="margin:0;font-size:12px;line-height:1.7;color:#9ca3af;">
      Это автоматическое сообщение, отвечать на него не нужно.<br>
      Вы получили его, потому что этот адрес был указан в {{.AppName}}.<br>
      &copy; {{.Year}} {{.AppName}}
    </p>
  </td></tr>

</table>

</td></tr>
</table>
</body>
</html>